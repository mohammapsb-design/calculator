#:kivy 2.2.0

<CalculatorLayout>:
    orientation: "vertical"
    padding: 10
    spacing: 10
    canvas.before:
        Color:
            rgba: 0.1, 0.1, 0.12, 1
        Rectangle:
            pos: self.pos
            size: self.size

    Label:
        text: root.display_text
        font_size: 48
        halign: "right"
        valign: "middle"
        size_hint_y: 0.25
        text_size: self.size
        color: 1, 1, 1, 1

    GridLayout:
        cols: 4
        spacing: 8
        size_hint_y: 0.75

        Button:
            text: "C"
            font_size: 24
            background_color: 0.8, 0.3, 0.3, 1
            on_release: root.on_clear_press()
        Button:
            text: "<-"
            font_size: 24
            background_color: 0.3, 0.3, 0.35, 1
            on_release: root.on_backspace_press()
        Button:
            text: "%"
            font_size: 24
            background_color: 0.3, 0.3, 0.35, 1
            disabled: True
        Button:
            text: "/"
            font_size: 24
            background_color: 0.95, 0.6, 0.1, 1
            on_release: root.on_operator_press("/")

        Button:
            text: "7"
            font_size: 24
            on_release: root.on_digit_press("7")
        Button:
            text: "8"
            font_size: 24
            on_release: root.on_digit_press("8")
        Button:
            text: "9"
            font_size: 24
            on_release: root.on_digit_press("9")
        Button:
            text: "*"
            font_size: 24
            background_color: 0.95, 0.6, 0.1, 1
            on_release: root.on_operator_press("*")

        Button:
            text: "4"
            font_size: 24
            on_release: root.on_digit_press("4")
        Button:
            text: "5"
            font_size: 24
            on_release: root.on_digit_press("5")
        Button:
            text: "6"
            font_size: 24
            on_release: root.on_digit_press("6")
        Button:
            text: "-"
            font_size: 24
            background_color: 0.95, 0.6, 0.1, 1
            on_release: root.on_operator_press("-")

        Button:
            text: "1"
            font_size: 24
            on_release: root.on_digit_press("1")
        Button:
            text: "2"
            font_size: 24
            on_release: root.on_digit_press("2")
        Button:
            text: "3"
            font_size: 24
            on_release: root.on_digit_press("3")
        Button:
            text: "+"
            font_size: 24
            background_color: 0.95, 0.6, 0.1, 1
            on_release: root.on_operator_press("+")

        Button:
            text: "0"
            font_size: 24
            on_release: root.on_digit_press("0")
        Button:
            text: "."
            font_size: 24
            on_release: root.on_digit_press(".")
        Button:
            text: "="
            font_size: 24
            background_color: 0.2, 0.6, 0.9, 1
            on_release: root.on_equals_press()
        Button:
            text: ""
            disabled: True
